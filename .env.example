# --- Jev (any OpenAI-compatible chat API) ---
JEV_API_KEY=sk-...
JEV_MODEL=gpt-4o
# Optional: change for Azure, OpenRouter, a local server, etc.
# JEV_BASE_URL=https://api.openai.com/v1
# Optional: custom system prompt (inline or path to a file)
# JEV_SYSTEM_PROMPT_FILE=jev_prompt.txt

# --- Polymarket ---
# Private key of the wallet that signs orders
POLY_PRIVATE_KEY=0x...
# 0 = plain EOA wallet, 1 = email/Magic proxy wallet, 2 = browser-wallet proxy (Gnosis Safe)
POLY_SIGNATURE_TYPE=1
# Address that holds the USDC (your Polymarket profile address). Required for type 1 and 2.
POLY_FUNDER=0x...

# --- Trading ---
BET_USDC=5            # USDC spent per 5m window
MAX_PRICE=0.70        # skip if the chosen side costs more than this per share
MAX_TRADES_PER_DAY=288
DRY_RUN=false         # true = decide and log, but place no orders
