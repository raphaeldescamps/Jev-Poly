# --- Jev (TypeSafe System One API) ---
JEV_API_KEY=
JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_TIMEOUT_SEC=10

# --- Polymarket ---
# Private key of the wallet that signs orders
POLY_PRIVATE_KEY=0x...
# 0 = plain wallet made by scripts/wallet.py (default), 1 = email/Magic proxy, 2 = browser-wallet proxy
POLY_SIGNATURE_TYPE=0
# Only for signature type 1 or 2: your Polymarket profile address
# POLY_FUNDER=0x...

# --- Trading ---
BET_USDC=5            # USDC spent per 5m window
MAX_PRICE=0.70        # never pay more than this per share
MIN_CONFIDENCE=0.55   # skip if Jev's probability for its side is below this
MIN_EDGE=0.03         # bet only if Jev's probability minus share price is at least this
MAX_TRADES_PER_DAY=288
DRY_RUN=false         # true = decide and log, but place no orders
